{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "build",
            "command": "E:\\mingw32\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "-Wall",
                "-Wextra",
                "${workspaceFolder}\\main.cpp",
                "${workspaceFolder}\\funtions.cpp",
                "${workspaceFolder}\\linklst.cpp",
                "-o",
                "${workspaceFolder}\\main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "编译 main.cpp + funtions.cpp + linklst.cpp -> main.exe（带 -g -O0，供 F5 调试）"
        }
    ]
}
